{
  "name": "uspeak-stem-server",
  "version": "0.1.0",
  "private": true,
  "description": "U-Speak STEM — a multiplayer science world. Colyseus server, judges every experiment.",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
