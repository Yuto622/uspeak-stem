    "marked": {
      "min": 10,
      "max": 60,
      "step": 10,
      "unit": "fish",
      "en": "Fish you mark",
      "ja": "しるしを つける かず"
    },
    "caught": {
      "min": 10,
      "max": 60,
      "step": 10,
      "unit": "fish",
      "en": "Fish you catch again",
      "ja": "また つかまえる かず"
    }
  },
  "levels": {
